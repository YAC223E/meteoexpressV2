# Météo Express Pro — Environment Variables
# Copy this file to .env and fill in your values.

# OpenWeatherMap API key (required)
# Get one at: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Groq API key (optional — enables AI recommendations)
# Get one at: https://console.groq.com
GROQ_API_KEY=

# Auth secret key (optional — has a default for local dev)
# Change this in production
AUTH_SECRET_KEY=
